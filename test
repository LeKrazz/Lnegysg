		local function verifyKey()
			local inputText = keyInput.Text
			local keyInvalid = (targetKey == nil or targetKey == "")

			if (not keyInvalid and inputText == targetKey) or (keyInvalid and inputText ~= "") then
				statusLabel.Text = "✓ Key accepted! Loading..."
				statusLabel.TextColor3 = theme.Success
				tween(confirmKeyBtn, { BackgroundColor3 = theme.Success }, 0.2)
				task.wait(0.8)

				tween(keyFrame, { BackgroundTransparency = 1 }, 0.25)
				task.wait(0.25)
				keyFrame:Destroy()

				showLoadingScreen(function()
					mainFrame.Visible = true
					tween(mainFrame, { BackgroundTransparency = 0 }, 0.3)
				end)
				return
			end

			statusLabel.Text = "✗ Incorrect key. Please try again."
			statusLabel.TextColor3 = theme.Error
			tween(inputBG, { BackgroundColor3 = Color3.fromRGB(60, 25, 25) }, 0.15)
			task.wait(0.4)
			tween(inputBG, { BackgroundColor3 = theme.ElementBG }, 0.3)

			task.delay(3, function()
				statusLabel.Text = "Enter your key to continue."
				statusLabel.TextColor3 = theme.TextMuted
			end)
		end

		confirmKeyBtn.MouseButton1Click:Connect(verifyKey)
		keyInput.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				verifyKey()
			end
		end)

		mainFrame.Visible = false
		return keyFrame
	end

