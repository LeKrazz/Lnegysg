							Size = UDim2.new(1, 0, 0, 13),
							Position = UDim2.new(0, 0, 0.5, 2),
							BackgroundTransparency = 1,
							Text = description,
							TextColor3 = theme.TextMuted,
							TextSize = 10,
							Font = Enum.Font.Gotham,
							TextXAlignment = Enum.TextXAlignment.Left,
							TextWrapped = true,
							ZIndex = 1014,
							Parent = labelFrame,
						})
					end
				end

				return row
			end

