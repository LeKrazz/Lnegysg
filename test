			function sectionObj.CreateToggle(_, toggleConfig)
				toggleConfig = toggleConfig or {}
				local toggleName = toggleConfig.Name or "Toggle"
				local toggleDesc = toggleConfig.Description or ""
				local state = toggleConfig.Default or false
				local callback = toggleConfig.Callback or function() end

				local row = createRowContainer(toggleName, toggleDesc, 40)
				local toggleObj = {}

				local trackBG = createInstance("Frame", {
					Name = "TrackBG",
					Size = UDim2.new(0, 44, 0, 24),
					Position = UDim2.new(1, -54, 0.5, -12),
					BackgroundColor3 = state and theme.ToggleOn or theme.ToggleOff,
					BorderSizePixel = 0,
					ZIndex = 1015,
					Parent = row,
				})
				createUICorner(trackBG, 12)

				local knob = createInstance("Frame", {
					Name = "Knob",
					Size = UDim2.new(0, 18, 0, 18),
					Position = UDim2.new(0, state and 23 or 3, 0.5, -9),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					ZIndex = 1016,
					Parent = trackBG,
				})
				createUICorner(knob, 9)

				local function updateToggle()
					tween(trackBG, { BackgroundColor3 = state and theme.ToggleOn or theme.ToggleOff }, 0.2)
					tween(knob, { Position = UDim2.new(0, state and 23 or 3, 0.5, -9) }, 0.2, Enum.EasingStyle.Back)
					callback(state)
				end

				local clickArea = createInstance("TextButton", {
					Name = "ToggleClickArea",
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					Text = "",
					ZIndex = 1017,
					Parent = row,
				})

				clickArea.MouseButton1Click:Connect(function()
					state = not state
					updateToggle()
				end)

				function toggleObj.Set(_, value)
					state = value
					updateToggle()
				end

				function toggleObj.Get(_)
					return state
				end

				row.MouseEnter:Connect(function()
					tween(row, { BackgroundColor3 = theme.ElementHover }, 0.12)
				end)
				row.MouseLeave:Connect(function()
					tween(row, { BackgroundColor3 = theme.ElementBG }, 0.12)
				end)

				if toggleConfig.Default then
					updateToggle()
				end

				return toggleObj
			end

			function sectionObj.CreateSlider(_, sliderConfig)
				sliderConfig = sliderConfig or {}
				local sliderName = sliderConfig.Name or "Slider"
				local minVal = sliderConfig.Min or 0
				local maxVal = sliderConfig.Max or 100
				local currentVal = sliderConfig.Default or maxVal
				local decimals = sliderConfig.Decimals or 0
				local suffix = sliderConfig.Suffix or ""
				local callback = sliderConfig.Callback or function() end

				local sliderObj = {}

				local row = createInstance("Frame", {
					Name = "SliderRow",
					Size = UDim2.new(1, 0, 0, 52),
					BackgroundColor3 = theme.ElementBG,
					BorderSizePixel = 0,
					ZIndex = 1012,
					Parent = sectionContent,
				})
				createUICorner(row, 7)

				createInstance("TextLabel", {
					Name = "SliderName",
					Size = UDim2.new(1, -20, 0, 18),
					Position = UDim2.new(0, 10, 0, 8),
					BackgroundTransparency = 1,
					Text = sliderName,
					TextColor3 = theme.TextPrimary,
					TextSize = 13,
					Font = Enum.Font.GothamSemibold,
					TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = 1013,
					Parent = row,
				})

				local valueLabel = createInstance("TextLabel", {
					Name = "ValueLabel",
					Size = UDim2.new(0, 80, 0, 18),
					Position = UDim2.new(1, -88, 0, 8),
					BackgroundTransparency = 1,
					Text = tostring(currentVal) .. suffix,
					TextColor3 = theme.Accent,
					TextSize = 12,
					Font = Enum.Font.GothamBold,
					TextXAlignment = Enum.TextXAlignment.Right,
					ZIndex = 1013,
					Parent = row,
				})

				local sliderTrack = createInstance("Frame", {
					Name = "SliderTrack",
					Size = UDim2.new(1, -20, 0, 6),
					Position = UDim2.new(0, 10, 0, 36),
					BackgroundColor3 = theme.Border,
					BorderSizePixel = 0,
					ZIndex = 1013,
					Parent = row,
				})
				createUICorner(sliderTrack, 3)

				local percent = (currentVal - minVal) / (maxVal - minVal)
				local sliderFill = createInstance("Frame", {
					Name = "SliderFill",
					Size = UDim2.new(percent, 0, 1, 0),
					BackgroundColor3 = theme.Accent,
					BorderSizePixel = 0,
					ZIndex = 1014,
					Parent = sliderTrack,
				})
				createUICorner(sliderFill, 3)

				local sliderThumb = createInstance("Frame", {
					Name = "SliderThumb",
					Size = UDim2.new(0, 14, 0, 14),
					Position = UDim2.new(percent, -7, 0.5, -7),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					ZIndex = 1015,
					Parent = sliderTrack,
				})
				createUICorner(sliderThumb, 7)
				createUIStroke(sliderThumb, theme.Accent, 2)

				local dragging = false

				local function updateSlider(rawValue)
					local clamped = math.clamp(rawValue, minVal, maxVal)
					local value = decimals ~= 0 and math.floor(clamped * 10 ^ decimals + 0.5) / 10 ^ decimals
						or math.round(clamped)

					currentVal = value
					local alpha = (value - minVal) / (maxVal - minVal)

					tween(sliderFill, { Size = UDim2.new(alpha, 0, 1, 0) }, 0.05)
					tween(sliderThumb, { Position = UDim2.new(alpha, -7, 0.5, -7) }, 0.05)
					valueLabel.Text = tostring(value) .. suffix
					callback(value)
				end

				local dragArea = createInstance("TextButton", {
					Name = "SliderDragArea",
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					Text = "",
					ZIndex = 1016,
					Parent = sliderTrack,
				})

				dragArea.MouseButton1Down:Connect(function()
					dragging = true
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = false
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
						local trackPos = sliderTrack.AbsolutePosition
						local trackSize = sliderTrack.AbsoluteSize
						local relativeX = (input.Position.X - trackPos.X) / trackSize.X
						updateSlider(minVal + math.clamp(relativeX, 0, 1) * (maxVal - minVal))
					end
				end)

				row.MouseEnter:Connect(function()
					tween(row, { BackgroundColor3 = theme.ElementHover }, 0.12)
				end)
				row.MouseLeave:Connect(function()
					tween(row, { BackgroundColor3 = theme.ElementBG }, 0.12)
				end)

				function sliderObj.Set(_, val)
					updateSlider(val)
				end

				function sliderObj.Get(_)
					return currentVal
				end

				return sliderObj
			end

