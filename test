	local function updateNotificationPositions(duration)
		local yOffset = 0
		duration = duration or 0.25
		for _, noti in ipairs(activeNotifications) do
			tween(noti.frame, { Position = UDim2.new(notificationXPos, 0, notificationYPos, yOffset) }, duration)
			yOffset = yOffset + 175 + 5
		end
	end

	local function removeNotification(targetFrame)
		for idx, noti in ipairs(activeNotifications) do
			if noti.frame == targetFrame then
				table.remove(activeNotifications, idx)
				break
			end
		end
		updateNotificationPositions()
	end

