	-- Theme Manager
	function windowObj.SetTheme(_, key, value)
		if Library.Theme[key] == nil then
			warn("NexusUI:SetTheme — unknown theme key: " .. tostring(key))
			return
		end

		Library.Theme[key] = value

		for object, propList in pairs(themeRegistry) do
			if object and object.Parent then
				for _, themeProp in ipairs(propList) do
					if key == themeProp.key then
						pcall(function()
							tween(object, { [themeProp.prop] = value }, 0.25)
						end)
					end
				end
			else
				themeRegistry[object] = nil
			end
		end

		if key == "Accent" then
			Library.Theme.ToggleOn = value
			Library.Theme.TabActive = value
		end
	end

