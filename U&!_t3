            switchContainer.AnchorPoint = Vector2.new(1, 0.5)
            switchContainer.Position = UDim2.new(1, -12, 0.5, 0)
            switchContainer.BackgroundColor3 = state and Color3.fromRGB(35, 35, 32) or Color3.fromRGB(160, 156, 142)
            switchContainer.BorderSizePixel = 0
            switchContainer.Parent = toggleFrame

            local switchCorner = Instance.new("UICorner")
            switchCorner.CornerRadius = UDim.new(1, 0)
            switchCorner.Parent = switchContainer

            local switchKnob = Instance.new("Frame")
            switchKnob.Size = UDim2.new(0, 16, 0, 16)
            switchKnob.AnchorPoint = Vector2.new(0, 0.5)
            switchKnob.Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
            switchKnob.BackgroundColor3 = Color3.fromRGB(235, 235, 230)
            switchKnob.BorderSizePixel = 0
            switchKnob.Parent = switchContainer

            local knobCorner = Instance.new("UICorner")
            knobCorner.CornerRadius = UDim.new(1, 0)
            knobCorner.Parent = switchKnob

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text = ""
            btn.Parent = toggleFrame

            local function UpdateToggle(newState)
                state = newState
                TweenService:Create(switchContainer, TweenInfo.new(0.2), {
                    BackgroundColor3 = state and Color3.fromRGB(35, 35, 32) or Color3.fromRGB(160, 156, 142)
                }):Play()
                TweenService:Create(switchKnob, TweenInfo.new(0.2), {
                    Position = state and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
                }):Play()
                pcall(callback, state)
            end

            TrackConnection(btn.MouseButton1Click:Connect(function()
                UpdateToggle(not state)
            end))

            -- Return object with Set method
            local toggleObj = {}
            function toggleObj:Set(newState)
                if newState ~= state then
                    UpdateToggle(newState)
                end
            end
            function toggleObj:GetState()
                return state
            end
            return toggleObj
        end

        -- CreateKeybind now returns an object with Set method
        function tab:CreateKeybind(text, defaultKey, callback)
            callback = callback or function() end
            local currentKey = defaultKey or Enum.KeyCode.E
            local isBinding = false

            local keybindFrame = Instance.new("Frame")
            keybindFrame.Size = UDim2.new(1, 0, 0, 36)
            keybindFrame.BackgroundColor3 = Color3.fromRGB(188, 184, 168)
            keybindFrame.BorderSizePixel = 0
            keybindFrame.Parent = tabContent

            local icon = Instance.new("Frame")
            icon.Size = UDim2.new(0, 12, 0, 12)
            icon.Position = UDim2.new(0, 12, 0.5, -6)
            icon.BackgroundColor3 = Color3.fromRGB(45, 45, 42)
            icon.BorderSizePixel = 0
            icon.Parent = keybindFrame

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0, 200, 1, 0)
            label.Position = UDim2.new(0, 36, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = text
            label.TextColor3 = Color3.fromRGB(45, 45, 42)
            label.TextSize = 14
            label.Font = Enum.Font.Code
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = keybindFrame

            local keyDisplay = Instance.new("TextLabel")
            keyDisplay.Size = UDim2.new(0, 80, 0, 22)
            keyDisplay.Position = UDim2.new(1, -90, 0.5, -11)
            keyDisplay.BackgroundColor3 = Color3.fromRGB(35, 35, 32)
            keyDisplay.BorderSizePixel = 0
            keyDisplay.Text = "[" .. currentKey.Name .. "]"
            keyDisplay.TextColor3 = Color3.fromRGB(235, 235, 230)
            keyDisplay.TextSize = 12
            keyDisplay.Font = Enum.Font.Code
            keyDisplay.Parent = keybindFrame

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text = ""
            btn.Parent = keybindFrame

            TrackConnection(btn.MouseButton1Click:Connect(function()
                isBinding = true
                keyDisplay.Text = "[...]"
            end))

            TrackConnection(UserInputService.InputBegan:Connect(function(input, processed)
                if isBinding then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        if input.KeyCode ~= Enum.KeyCode.Unknown then
                            currentKey = input.KeyCode
                            keyDisplay.Text = "[" .. currentKey.Name .. "]"
                            isBinding = false
                        end
                    end
                elseif not processed then
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
                        pcall(callback, currentKey)
                    end
                end
            end))

            -- Return object with Set method
            local keybindObj = {}
            function keybindObj:Set(newKey)
                if typeof(newKey) == "EnumItem" and newKey.EnumType == Enum.KeyCode then
                    currentKey = newKey
                    keyDisplay.Text = "[" .. currentKey.Name .. "]"
                end
            end
            function keybindObj:GetKey()
                return currentKey
            end
            return keybindObj
        end

        return tab
    end

    function window:Destroy()
        for _, conn in ipairs(self.Connections) do
            if typeof(conn) == "RBXScriptConnection" and conn.Connected then
                conn:Disconnect()
            end
        end
        screenGui:Destroy()
        getgenv().NierUI_Instance = nil
    end

    getgenv().NierUI_Instance = window

    return window
end

return Library
