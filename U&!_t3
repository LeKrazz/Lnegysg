            trackBar.Position = UDim2.new(0, 0, 0.5, -1)
            trackBar.BackgroundColor3 = Color3.fromRGB(80, 80, 75)
            trackBar.BorderSizePixel = 0
            trackBar.Parent = trackContainer

            local fillBar = Instance.new("Frame")
            fillBar.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            fillBar.BackgroundColor3 = Color3.fromRGB(35, 35, 32)
            fillBar.BorderSizePixel = 0
            fillBar.Parent = trackBar

            local handle = Instance.new("Frame")
            handle.Size = UDim2.new(0, 4, 0, 14)
            handle.AnchorPoint = Vector2.new(0.5, 0.5)
            handle.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
            handle.BackgroundColor3 = Color3.fromRGB(35, 35, 32)
            handle.BorderSizePixel = 0
            handle.Parent = trackBar

            local dragging = false

            local function SetValue(value)
                value = math.clamp(value, min, max)
                local pos = (value - min) / (max - min)
                valBox.Text = tostring(value)
                fillBar.Size = UDim2.new(pos, 0, 1, 0)
                handle.Position = UDim2.new(pos, 0, 0.5, 0)
                pcall(callback, value)
            end

            local function UpdateFromInput(input)
                local pos = math.clamp((input.Position.X - trackBar.AbsolutePosition.X) / trackBar.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + (max - min) * pos)
                SetValue(val)
            end

            TrackConnection(trackContainer.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateFromInput(input)
                end
            end))

            TrackConnection(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end))

            TrackConnection(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateFromInput(input)
                end
            end))

            -- Return object with Set method
            local sliderObj = {}
            function sliderObj:Set(value)
                SetValue(value)
            end
            function sliderObj:GetValue()
                return tonumber(valBox.Text)
            end
            return sliderObj
        end

        function tab:CreateToggle(text, default, callback)
            callback = callback or function() end
            local state = default or false

            local toggleFrame = Instance.new("Frame")
